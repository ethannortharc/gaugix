# Gaugix environment — copy to .env and fill what you have.
# Keys are read from env only: never stored in the DB, never logged, never in reports.

# LLM provider keys (leave empty to skip that provider; FakeHarness needs none)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: any OpenAI-compatible gateway (OpenRouter, DeepSeek, Ollama, ...)
OPENROUTER_API_KEY=

# App settings (defaults shown)
GAUGIX_PORT=8317
GAUGIX_DATA_DIR=./data
GAUGIX_PROVIDER_CONCURRENCY=4

# Real-API smoke budget: hard cap on cumulative calls from `make smoke`.
GAUGIX_SMOKE_MAX_CALLS=50
